<UserControl x:Class="GameLanguageExplorer.WPF.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Bildirim şeridi: içerikten AYRI satırda; böylece hiçbir zaman içeriğin arkasında kalmaz. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1) Araç çubuğu -->
        <Border Grid.Row="0" Background="{DynamicResource App.Surface}" Padding="16,12" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="GLOBAL OYUN KATALOGU" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource App.AccentDefault}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Padding="8,4" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameCount, StringFormat='{}{0} oyun'}" Foreground="{DynamicResource App.TextSecondary}" />
                    </Border>
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Width="220" Margin="0,0,8,0" VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Ara" Command="{Binding SearchCommand}" Padding="12,6" />
                    <Button Content="Steam'den Ekle" Command="{Binding ImportFromSteamCommand}" Padding="12,6"
                            ToolTip="Arama kutusundaki adı Steam'de arar ve sonuçları kataloğa ekler (API anahtarı gerekmez)." />
                    <Button Content="Yenile" Command="{Binding RefreshCommand}" Padding="12,6" />
                    <Button Content="Tam Katalog Senkronize Et" Command="{Binding SyncCommand}" Padding="12,6"
                            ToolTip="Steam Web API anahtarı (STEAM_API_KEY) gerektirir." />
                    <Button Content="İptal" Command="{Binding CancelCommand}" Padding="12,6" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 2) Bildirim şeridi (durum / iptal / senkronizasyon istatistikleri) -->
        <StackPanel Grid.Row="1">

            <Border Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,0,6"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource App.TextSecondary}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource App.ErrorSoft}" BorderBrush="{DynamicResource App.Error}" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠ " Foreground="{DynamicResource App.Error}" FontWeight="Bold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource App.Error}" TextWrapping="Wrap" MaxWidth="900" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource App.SuccessSoft}" BorderBrush="{DynamicResource App.Success}" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding SyncTotalFetched, Converter={StaticResource IntToVisibilityConverter}}">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Alınan: " Foreground="{DynamicResource App.Warning}" FontWeight="Bold" />
                    <TextBlock Text="{Binding SyncTotalFetched}" Foreground="{DynamicResource App.TextPrimary}" Margin="0,0,16,0" />
                    <TextBlock Text="Eklenen: " Foreground="{DynamicResource App.Success}" FontWeight="Bold" />
                    <TextBlock Text="{Binding SyncAdded}" Foreground="{DynamicResource App.TextPrimary}" Margin="0,0,16,0" />
                    <TextBlock Text="Güncellenen: " Foreground="{DynamicResource App.Info}" FontWeight="Bold" />
                    <TextBlock Text="{Binding SyncUpdated}" Foreground="{DynamicResource App.TextPrimary}" />
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- 3) İçerik: liste + detay -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock Text="Oyun Listesi (ilk 100)" DockPanel.Dock="Top" FontSize="14" FontWeight="Bold"
                               Margin="16,16,16,8" Foreground="{DynamicResource App.TextSecondary}" />
                    <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Margin="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="8" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource App.TextPrimary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Developer}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource App.Background}" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Oyun Profili" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource App.AccentDefault}" />

                        <TextBlock Text="{Binding SelectedGame.Name, FallbackValue='Oyun seçiniz'}"
                                   FontSize="24" FontWeight="Bold" Foreground="{DynamicResource App.TextPrimary}" TextWrapping="Wrap" />

                        <TextBlock Text="{Binding SelectedGame.Description, FallbackValue='Bir oyun seçerek detaylı bilgi görebilirsiniz.'}"
                                   FontSize="14" Foreground="{DynamicResource App.TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Geliştirici:" FontWeight="Bold" Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedGame.Developer, FallbackValue='-', TargetNullValue='-'}"
                                           Foreground="{DynamicResource App.TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <TextBlock Text="Yayıncı:" FontWeight="Bold" Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedGame.Publisher, FallbackValue='-', TargetNullValue='-'}"
                                           Foreground="{DynamicResource App.TextPrimary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

