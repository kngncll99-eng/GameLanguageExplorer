<UserControl x:Class="GameLanguageExplorer.WPF.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1200"
             Background="{DynamicResource App.Background}">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        </Style>

        <Style x:Key="SmallText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource App.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="{DynamicResource App.GridRow}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource App.GridRowAlt}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="YERELLEŞTİRME EDİTÖRÜ" FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource App.TextPrimary}" />
                    <TextBlock Text="Kaynak metni solda, çeviriyi sağda düzenleyin. Kaydetme öncesi yedek alınır."
                               FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.TextSecondary}" />
                </StackPanel>

                <Button Grid.Column="1" Content="Oyunları Yenile" Command="{Binding ReloadCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,12,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="KURULU OYUN" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                              MinWidth="280" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Game.Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding InstallPath}" FontSize="10"
                                               Foreground="{DynamicResource App.TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="DİL DOSYASI" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                              MinWidth="280" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" />
                                    <TextBlock Text="{Binding SupportText}" FontSize="10"
                                               Foreground="{DynamicResource App.TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="3" Content="Metinleri Yükle" Command="{Binding LoadEntriesCommand}"
                        VerticalAlignment="Bottom" Margin="12,0,0,2" />
            </Grid>
        </Border>


        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="16,10,16,0" Padding="12,9">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="160" Margin="0,0,16,0">
                        <TextBlock Text="DÜZENLEME" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="Düzenlenebilir (JSON)" FontSize="12"
                                   Foreground="{DynamicResource App.Success}"
                                   Visibility="{Binding IsEditingEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="Salt okunur" FontSize="12"
                                   Foreground="{DynamicResource App.TextMuted}"
                                   Visibility="{Binding IsEditingEnabled, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,16,0">
                        <TextBlock Text="KAYIT" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding EntryCount}" FontSize="12"
                                   Foreground="{DynamicResource App.TextPrimary}" />
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,16,0">
                        <TextBlock Text="DEĞİŞİKLİK" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ChangedCount}" FontSize="12"
                                   Foreground="{DynamicResource App.TextPrimary}" />
                    </StackPanel>
                    <Button Content="Değişiklikleri Kaydet" Command="{Binding SaveCommand}"
                            Style="{StaticResource App.AccentButton}" VerticalAlignment="Bottom"
                            ToolTip="Yalnızca yazma destekli dosyalarda aktiftir." />
                    <Button Content="Kaydetmeyi İptal Et" Command="{Binding CancelSaveCommand}"
                            VerticalAlignment="Bottom"
                            Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}" />
                </WrapPanel>

                <ProgressBar Value="{Binding SaveProgressPercent}" Maximum="100" Margin="0,9,0,0"
                             Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SmallText}"
                           Margin="0,6,0,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextPrimary}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Text="{Binding WarningMessage}" Style="{StaticResource SmallText}"
                           Margin="0,5,0,0" Foreground="{DynamicResource App.Warning}"
                           Visibility="{Binding WarningMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource SmallText}"
                           Margin="0,5,0,0" Foreground="{DynamicResource App.Error}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Text="{Binding SaveStatusMessage}" Style="{StaticResource SmallText}"
                           Margin="0,5,0,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Success}"
                           Visibility="{Binding SaveStatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Text="{Binding SaveErrorMessage}" Style="{StaticResource SmallText}"
                           Margin="0,5,0,0" Foreground="{DynamicResource App.Error}"
                           Visibility="{Binding SaveErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="16,10,16,16" Padding="0">
            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                      IsReadOnly="False" VirtualizingPanel.ScrollUnit="Pixel">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ANAHTAR" Binding="{Binding Key}" Width="190" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="ORİJİNAL METİN" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap"
                                           MaxHeight="110" ToolTip="{Binding SourceText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="ÇEVİRİ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding TranslationText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsEditable}" TextWrapping="Wrap"
                                         MinHeight="28" MaxHeight="110" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="DURUM" Binding="{Binding StatusText}" Width="105" IsReadOnly="True" />
                    <DataGridTextColumn Header="YER TUTUCU" Binding="{Binding PlaceholderText}" Width="150" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
