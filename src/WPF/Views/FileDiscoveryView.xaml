<UserControl x:Class="GameLanguageExplorer.WPF.Views.FileDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1100"
             Background="{DynamicResource App.Background}">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 1) Başlık + oyun seçimi + eylemler ───────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="DİL DOSYASI KEŞFİ" FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource App.TextPrimary}" />
                    <TextBlock Text="Kurulum klasörü salt okunur taranır; aday dosyalar listelenir ve metinler önizlenir."
                               FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="Oyun:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource App.TextSecondary}" />

                        <!-- Tema uyumlu oyun seçici: ad her zaman tam, yalnızca yol kısaltılır -->
                        <Button Width="380" HorizontalContentAlignment="Left" Padding="10,7"
                                Command="{Binding ToggleGameListCommand}"
                                ToolTip="{Binding SelectedGame.InstallPath}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedGame.Game.Name}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.TextPrimary}" />
                                <TextBlock Text="  ·  " VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.TextMuted}" />
                                <TextBlock Text="{Binding SelectedGame.InstallPath}" FontSize="11"
                                           VerticalAlignment="Center" MaxWidth="120"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource App.TextSecondary}" />
                                <Path Data="M 0 0 L 4.5 4.5 L 9 0" StrokeThickness="1.6"
                                      Stroke="{DynamicResource App.TextSecondary}"
                                      VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Seçici listesi (popup yerine satır içi; iki temada da okunur) -->
                    <Border Margin="0,8,0,0" MaxWidth="620" HorizontalAlignment="Left"
                            Background="{DynamicResource App.Surface}"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="6"
                            Visibility="{Binding IsGameListOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                                 BorderThickness="0" Background="Transparent" MaxHeight="220" Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Game.Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource App.TextPrimary}" />
                                        <TextBlock Text="{Binding InstallPath}" FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource App.TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <Button Content="Dil Dosyalarını Tara" Command="{Binding ScanCommand}"
                            Style="{StaticResource App.AccentButton}"
                            ToolTip="Seçili kurulum klasörünü salt okunur tarar" />
                    <Button Content="İptal" Command="{Binding CancelCommand}"
                            ToolTip="Sürmekte olan taramayı durdurur" />
                    <Button Content="Yenile" Command="{Binding ReloadCommand}" Margin="0"
                            ToolTip="Oyun listesini ve kayıtlı adayları yeniler" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ── 2) Sayaç kartları ────────────────────────────────────────────── -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="20,14,10,0">
            <Border Style="{StaticResource StatCard}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" CornerRadius="2" Margin="0,0,10,0" Background="{Binding AccentBrush}" />
                    <StackPanel>
                        <TextBlock Text="Taranan dosya" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" />
                        <TextBlock Text="{Binding FilesSeen}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimary}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" CornerRadius="2" Margin="0,0,10,0" Background="{Binding AccentBrush}" />
                    <StackPanel>
                        <TextBlock Text="Bulunan aday" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" />
                        <TextBlock Text="{Binding CandidatesFound}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimary}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" CornerRadius="2" Margin="0,0,10,0" Background="{DynamicResource App.Success}" />
                    <StackPanel>
                        <TextBlock Text="Eklenen" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" />
                        <TextBlock Text="{Binding AddedCount}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimary}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" CornerRadius="2" Margin="0,0,10,0" Background="{DynamicResource App.Warning}" />
                    <StackPanel>
                        <TextBlock Text="Bulunamayan" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" />
                        <TextBlock Text="{Binding MissingCount}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextPrimary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ── 3) İlerleme + bildirimler ────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Margin="20,12,20,0">
            <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Taranıyor…" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextPrimary}" />
                    <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Foreground="{Binding AccentBrush}" />
                    <TextBlock Text="{Binding CurrentDirectory}" FontSize="11" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource App.TextSecondary}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource App.InfoSoft}" BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,8,0,0"
                    Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource App.Info}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.TextPrimary}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource App.WarningSoft}" BorderBrush="{DynamicResource App.Warning}"
                    BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,8,0,0"
                    Visibility="{Binding WarningMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource App.Warning}" />
                    <TextBlock Text="{Binding WarningMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.TextPrimary}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource App.ErrorSoft}" BorderBrush="{DynamicResource App.Error}"
                    BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,8,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource App.Error}" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.TextPrimary}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── 4) Dosya listesi ─────────────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="20,14,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="130" />
                <RowDefinition Height="8" />
                <RowDefinition Height="3*" MinHeight="200" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Keşfedilen dosyalar" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.TextPrimary}" />
                                <Border Background="{Binding AccentTintBrush}" CornerRadius="10"
                                        Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalCount}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.TextPrimary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding LastScanText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource App.TextSecondary}" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                              BorderThickness="0" Background="Transparent"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Dosya" Width="420">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource App.TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FilePath}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource App.TextSecondary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Uzantı" Width="80"
                                                DisplayMemberBinding="{Binding Extension}" />
                                <GridViewColumn Header="Boyut" Width="90"
                                                DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="Format" Width="80"
                                                DisplayMemberBinding="{Binding FormatKey}" />
                                <GridViewColumn Header="Destek" Width="190">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Durum yalnızca renkle değil, metinle de ifade edilir. -->
                                            <TextBlock Text="{Binding SupportText}" FontSize="12"
                                                       TextWrapping="Wrap" MaxWidth="180"
                                                       ToolTip="{Binding SupportText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SupportsPreview}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="1" Padding="20"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                            <TextBlock Text="📂" FontSize="30" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource App.TextMuted}" />
                            <TextBlock Text="Dil dosyası adayı yok" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,8,0,6"
                                       Foreground="{DynamicResource App.TextPrimary}" />
                            <TextBlock Text="{Binding EmptyMessage}" FontSize="12" TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource App.TextSecondary}" />
                            <Button Content="Dil Dosyalarını Tara" Command="{Binding ScanCommand}"
                                    Style="{StaticResource App.AccentButton}"
                                    HorizontalAlignment="Center" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Önizleme başlığı -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="METİN ÖNİZLEME" FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{DynamicResource App.TextPrimary}" />
                                <TextBlock Text="{Binding PreviewTitle}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource App.TextPrimary}" />
                                <TextBlock Text="{Binding PreviewAdapterText}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource App.TextSecondary}" />
                                <TextBlock Text="{Binding PreviewDurationText}" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.TextMuted}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="İlerleme/iptal yok (tek dosya)" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{DynamicResource App.TextMuted}" />
                                <CheckBox Content="Atlananları göster" FontSize="12" Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowSkippedPreviewEntries}" />
                                <Button Content="Metinleri Önizle" Command="{Binding PreviewCommand}"
                                        Style="{StaticResource App.AccentButton}" Margin="0"
                                        ToolTip="Seçili dosyayı salt okunur ayrıştırır" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sayaçlar / durum -->
                    <Border Grid.Row="1" Padding="14,8" Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                        <WrapPanel>
                            <TextBlock Text="Çevrilebilir:" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Success}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding PreviewTranslatableCount}" FontSize="12" Margin="0,0,14,0"
                                       Foreground="{DynamicResource App.TextPrimary}" />
                            <TextBlock Text="Belirsiz:" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Warning}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding PreviewAmbiguousCount}" FontSize="12" Margin="0,0,14,0"
                                       Foreground="{DynamicResource App.TextPrimary}" />
                            <TextBlock Text="Atlanan:" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding PreviewSkippedCount}" FontSize="12" Margin="0,0,14,0"
                                       Foreground="{DynamicResource App.TextPrimary}" />
                            <TextBlock Text="{Binding PreviewStatusMessage}" FontSize="12"
                                       Foreground="{DynamicResource App.TextSecondary}" />
                        </WrapPanel>
                    </Border>

                    <!-- Önizleme uyarı / hata -->
                    <StackPanel Grid.Row="2">
                        <Border Background="{DynamicResource App.WarningSoft}" BorderBrush="{DynamicResource App.Warning}"
                                BorderThickness="0,0,0,1" Padding="14,8"
                                Visibility="{Binding PreviewWarningMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding PreviewWarningMessage}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.TextPrimary}" />
                        </Border>
                        <Border Background="{DynamicResource App.ErrorSoft}" BorderBrush="{DynamicResource App.Error}"
                                BorderThickness="0,0,0,1" Padding="14,8"
                                Visibility="{Binding PreviewErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding PreviewErrorMessage}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource App.TextPrimary}" />
                        </Border>
                    </StackPanel>

                    <!-- Kayıt tablosu + ayrıntı paneli -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <ListView ItemsSource="{Binding PreviewEntries}"
                                      SelectedItem="{Binding SelectedPreviewEntry}"
                                      BorderThickness="0" Background="Transparent"
                                      Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Konum / anahtar" Width="210">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Key}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="200"
                                                               Foreground="{DynamicResource App.TextPrimary}"
                                                               ToolTip="{Binding Key}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Orijinal metin / mevcut çeviri" Width="380">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <!-- Tek satır: tam metin ayrıntı panelinde okunur.
                                                             Böylece satır yüksekliği değişmez, metin üst üste binmez. -->
                                                        <TextBlock Text="{Binding SourceText}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="360"
                                                                   Foreground="{DynamicResource App.TextPrimary}"
                                                                   ToolTip="{Binding SourceText}" />
                                                        <TextBlock Text="{Binding ExistingTranslation}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="360"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource App.Success}"
                                                                   ToolTip="{Binding ExistingTranslation}"
                                                                   Visibility="{Binding HasExistingTranslation, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Durum" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTranslatable}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource App.Success}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsAmbiguous}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource App.Warning}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <Border Padding="20"
                                    Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                                    <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource App.TextMuted}" />
                                    <TextBlock Text="Önizleme için bir dosya seçin" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,8,0,6"
                                               Foreground="{DynamicResource App.TextPrimary}" />
                                    <TextBlock FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource App.TextSecondary}"
                                               Text="Yukarıdaki listeden bir aday seçip 'Metinleri Önizle' düğmesine basın. Dosya salt okunur ayrıştırılır." />
                                    <TextBlock FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                                               Foreground="{DynamicResource App.TextMuted}"
                                               Text="Desteklenen ayrıştırıcılar: JSON, XML, CSV, TSV, PO, POT, INI, LocresCSV." />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Seçili kaydın ayrıntı paneli: uzun metinler burada tam okunur -->
                        <Border Grid.Column="1" Background="{DynamicResource App.Background}"
                                BorderBrush="{DynamicResource App.Border}" BorderThickness="1,0,0,0"
                                Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="SEÇİLİ KAYIT" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource App.TextMuted}" />

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <StackPanel Visibility="{Binding HasSelectedPreviewEntry, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Kaynak metin" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding SelectedPreviewEntry.SourceText}"
                                                   Style="{StaticResource DetailValue}"
                                                   Foreground="{DynamicResource App.TextPrimary}" FontSize="13" />

                                        <TextBlock Text="Mevcut çeviri" Style="{StaticResource DetailLabel}"
                                                   Visibility="{Binding SelectedPreviewEntry.HasExistingTranslation, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding SelectedPreviewEntry.ExistingTranslation}"
                                                   Style="{StaticResource DetailValue}" FontSize="13"
                                                   Foreground="{DynamicResource App.Success}"
                                                   Visibility="{Binding SelectedPreviewEntry.HasExistingTranslation, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Text="Konum / anahtar" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding SelectedPreviewEntry.Key}" Style="{StaticResource DetailValue}"
                                                   Foreground="{DynamicResource App.TextPrimary}" />

                                        <TextBlock Text="Durum" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding SelectedPreviewEntry.StatusText}" Style="{StaticResource DetailValue}"
                                                   Foreground="{DynamicResource App.TextPrimary}" />

                                        <TextBlock Text="Atlanma nedeni" Style="{StaticResource DetailLabel}"
                                                   Visibility="{Binding SelectedPreviewEntry.IsSkipped, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding SelectedPreviewEntry.SkipReason}"
                                                   Style="{StaticResource DetailValue}"
                                                   Foreground="{DynamicResource App.Error}"
                                                   Visibility="{Binding SelectedPreviewEntry.IsSkipped, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Text="Bağlam" Style="{StaticResource DetailLabel}"
                                                   Visibility="{Binding SelectedPreviewEntry.ContextText, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding SelectedPreviewEntry.ContextText}" Style="{StaticResource DetailValue}"
                                                   Visibility="{Binding SelectedPreviewEntry.ContextText, Converter={StaticResource StringToVisibilityConverter}}" />

                                        <TextBlock Text="Çoğul / işaret / referans" Style="{StaticResource DetailLabel}"
                                                   Visibility="{Binding SelectedPreviewEntry.HasMeta, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding SelectedPreviewEntry.MetaText}" Style="{StaticResource DetailValue}"
                                                   Visibility="{Binding SelectedPreviewEntry.HasMeta, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Text="Değişken / biçimlendirme" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding SelectedPreviewEntry.PlaceholderText}" Style="{StaticResource DetailValue}" />

                                        <TextBlock Text="Kanıt" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding SelectedPreviewEntry.Evidence}" Style="{StaticResource DetailValue}"
                                                   Foreground="{DynamicResource App.TextSecondary}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <TextBlock Grid.Row="1" Text="Ayrıntı için tablodan bir satır seçin."
                                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           VerticalAlignment="Top"
                                           Foreground="{DynamicResource App.TextSecondary}"
                                           Visibility="{Binding HasSelectedPreviewEntry, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>









