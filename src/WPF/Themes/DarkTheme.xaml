<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        KOYU TEMA. Açık tema ile AYNI anahtar setini sağlar; ThemeManager yalnızca bu sözlüğü
        değiştirir. View'lar renkleri buradan DynamicResource ile alır.
    -->

    <!-- Yüzeyler -->
    <SolidColorBrush x:Key="App.Background" Color="#14161A" />
    <SolidColorBrush x:Key="App.Surface" Color="#1B1E24" />
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#232730" />
    <SolidColorBrush x:Key="App.SurfaceHover" Color="#2C313B" />
    <SolidColorBrush x:Key="App.Border" Color="#333945" />
    <SolidColorBrush x:Key="App.BorderStrong" Color="#454C5A" />

    <!-- Metin -->
    <SolidColorBrush x:Key="App.TextPrimary" Color="#F2F4F7" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#C2CAD8" />
    <SolidColorBrush x:Key="App.TextMuted" Color="#94A0B0" />
    <SolidColorBrush x:Key="App.TextOnAccent" Color="#0B0D10" />

    <!-- Varsayılan vurgu (oyun paleti yoksa) -->
    <SolidColorBrush x:Key="App.AccentDefault" Color="#4C8DFF" />

    <!-- Tablo -->
    <SolidColorBrush x:Key="App.GridRow" Color="#1B1E24" />
    <SolidColorBrush x:Key="App.GridRowAlt" Color="#1F232A" />
    <SolidColorBrush x:Key="App.Selection" Color="#2A3A55" />
    <SolidColorBrush x:Key="App.SelectionBorder" Color="#4C8DFF" />
    <SolidColorBrush x:Key="App.FocusRing" Color="#7FB0FF" />

    <!-- Durum renkleri (metin + yumuşak arka plan) -->
    <SolidColorBrush x:Key="App.Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="App.SuccessSoft" Color="#14301F" />
    <SolidColorBrush x:Key="App.Warning" Color="#F5C451" />
    <SolidColorBrush x:Key="App.WarningSoft" Color="#33290F" />
    <SolidColorBrush x:Key="App.Error" Color="#FF8F8F" />
    <SolidColorBrush x:Key="App.ErrorSoft" Color="#3A1C1C" />
    <SolidColorBrush x:Key="App.Info" Color="#7FB8FF" />
    <SolidColorBrush x:Key="App.InfoSoft" Color="#16283C" />
</ResourceDictionary>
